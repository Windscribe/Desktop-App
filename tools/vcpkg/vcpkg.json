{
    "dependencies": [
        "qtbase",
        "qtsvg",
        {
            "name": "qtimageformats",
            "default-features": false
        }, 
        {
            "name": "qttools",
            "default-features": false,
            "features": [ "linguist" ]
        }, 
        {
            "name": "qtwayland",
            "platform": "linux"
        },
        "boost-asio",
        "boost-filesystem",
        "boost-logic",
        "boost-serialization",
        "boost-thread",
        "boost-process",
        "openssl",
        "openvpn",
        "gtest",
       {    
            "name": "spdlog",
            "features": [ { "name": "wchar", "platform": "windows" } ]
        },
        {
            "name": "curl",
            "features": [ "openssl", "ech" ]
        },
        "rapidjson",
        "skyr-url",
        "cmakerc",
        "cpp-base64",
        "c-ares",
        "advobfuscator",
        "miniaudio",
        "ctrld",
        "amneziawg",
        {
            "name": "wireguard-windows",
            "platform": "windows"
        },
        {
            "name": "libarchive",
            "default-features": false,
            "features": [ "lzma" ],
            "platform": "windows"
        },
        {
            "name": "tap-windows6-driver",
            "platform": "windows"
        },
        {
            "name": "winreg",
            "platform": "windows"
        }
    ],
    "overrides": [
        { "name": "advobfuscator", "version": "2020-06-26" },
        { "name": "winreg", "version": "6.3.2" }
    ]
}
