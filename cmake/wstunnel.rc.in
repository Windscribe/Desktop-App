#include <windows.h>

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @WSTUNNEL_VERSION_NUMBERS@
    PRODUCTVERSION @WSTUNNEL_VERSION_NUMBERS@
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS VOS__WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE 0x0L
    BEGIN
        BLOCK "StringFileInfo"
        BEGIN
            BLOCK "040904b0"
            BEGIN
                VALUE "CompanyName", "@WS_VENDOR@\0"
                VALUE "FileDescription", "@WS_PRODUCT_NAME@ wstunnel\0"
                VALUE "FileVersion", "@WSTUNNEL_VERSION@\0"
                VALUE "LegalCopyright", "@WS_COPYRIGHT@\0"
                VALUE "OriginalFilename", "@WS_PRODUCT_NAME_LOWER@wstunnel.exe\0"
                VALUE "ProductName", "@WS_PRODUCT_NAME@\0"
                VALUE "ProductVersion", "@WSTUNNEL_VERSION@\0"
            END
        END
        BLOCK "VarFileInfo"
        BEGIN
            VALUE "Translation", 0x0409, 1200
        END
    END
